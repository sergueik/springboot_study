FROM eclipse-temurin:11-jre

ENV DEBIAN_FRONTEND=noninteractive 
USER root
RUN  rm -rf /var/cache/apt && mkdir -p /var/cache/apt/archives/partial \
&& apt clean && apt-get update || true 
RUN apt-get -y install \
  unoconv \
  hyphen-af hyphen-en-us \
  fonts-dejavu fonts-dejavu-core fonts-dejavu-extra \
  fonts-droid-fallback fonts-dustin fonts-f500 fonts-fanwood fonts-freefont-ttf fonts-liberation \
  fonts-lmodern fonts-lyx fonts-sil-gentium fonts-texgyre fonts-tlwg-purisa fonts-opensymbol || true

RUN apt-get -y install \
x11-common libreoffice-common  libreoffice-base-core libreoffice-core-nogui libice6 libsm6:amd64 libreoffice-common \
  && rm -rf /var/lib/apt/lists/*

EXPOSE 8100

CMD /usr/bin/libreoffice --headless --nologo --nofirststartwizard --accept="socket,host=0.0.0.0,port=8100;urp"

